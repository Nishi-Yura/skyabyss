{
  "multipart": [
    {
      "apply": {
        "model": "skyabyss:block/anemone_tally"
      }
    },
    {
      "when": {
        "count": "1|2|3|4|5"
      },
      "apply": {
        "model": "skyabyss:block/anemone_tally_dot0"
      }
    },
    {
      "when": {
        "count": "2|3|4|5"
      },
      "apply": {
        "model": "skyabyss:block/anemone_tally_dot1"
      }
    },
    {
      "when": {
        "count": "3|4|5"
      },
      "apply": {
        "model": "skyabyss:block/anemone_tally_dot2"
      }
    },
    {
      "when": {
        "count": "4|5"
      },
      "apply": {
        "model": "skyabyss:block/anemone_tally_dot3"
      }
    },
    {
      "when": {
        "count": "5"
      },
      "apply": {
        "model": "skyabyss:block/anemone_tally_dot4"
      }
    }
  ]
}
